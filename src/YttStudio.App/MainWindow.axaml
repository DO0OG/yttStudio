<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:YttStudio.App"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        x:Class="YttStudio.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="700"
        Title="YttStudio"
        Icon="/Assets/app.ico">
  <Grid RowDefinitions="Auto,Auto,*,40" Margin="0" RowSpacing="0">
    <Menu Grid.Row="0" Background="{DynamicResource AppMenuBackgroundBrush}" Padding="4,2">
      <MenuItem Header="{Binding Loc[MenuFile]}">
        <MenuItem Header="{Binding Loc[OpenProject]}" Command="{Binding OpenProjectCommand}" />
        <MenuItem Header="{Binding Loc[SaveProject]}" Command="{Binding SaveProjectCommand}" />
        <Separator />
        <MenuItem Header="{Binding Loc[OpenSubtitle]}" Command="{Binding OpenSubtitleCommand}" />
        <MenuItem Header="{Binding Loc[OpenVideo]}" Command="{Binding OpenVideoCommand}" />
        <MenuItem Header="{Binding Loc[SaveYtt]}" Command="{Binding SaveCommand}" />
        <Separator />
        <MenuItem Header="{Binding Loc[MenuExit]}" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding Loc[MenuEdit]}">
        <MenuItem Header="{Binding Loc[Undo]}" Command="{Binding UndoCommand}" />
        <MenuItem Header="{Binding Loc[Redo]}" Command="{Binding RedoCommand}" />
        <Separator />
        <MenuItem Header="{Binding Loc[Duplicate]}" Command="{Binding DuplicateCueCommand}" />
        <MenuItem Header="{Binding Loc[Delete]}" Command="{Binding DeleteCueCommand}" />
        <Separator />
        <MenuItem Header="{Binding Loc[ReplaceAll]}" Command="{Binding ReplaceAllCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding Loc[MenuView]}">
        <MenuItem Header="{Binding Loc[MenuSafeArea]}" ToggleType="CheckBox" IsChecked="{Binding ShowSafeArea}" />
        <MenuItem Header="{Binding Loc[MenuAnchors]}" ToggleType="CheckBox" IsChecked="{Binding ShowAnchors}" />
        <MenuItem Header="{Binding Loc[CheckerboardBg]}" ToggleType="CheckBox" IsChecked="{Binding UseCheckerboard}" />
      </MenuItem>
      <MenuItem Header="{Binding Loc[MenuSubtitle]}">
        <MenuItem Header="{Binding Loc[AddCueAtTime]}" Command="{Binding AddCueCommand}" />
        <MenuItem Header="{Binding Loc[BringToFront]}" Command="{Binding BringToFrontCommand}" />
        <MenuItem Header="{Binding Loc[SendToBack]}" Command="{Binding SendToBackCommand}" />
        <Separator />
        <MenuItem Header="{Binding Loc[AutoSplit]}" Command="{Binding AutoSplitKaraokeCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding Loc[MenuTools]}">
        <MenuItem Header="{Binding Loc[RunCheck]}" Command="{Binding ValidateCommand}" />
        <MenuItem Header="{Binding Loc[ShiftSelected]}" Command="{Binding ShiftSelectedCommand}" />
        <MenuItem Header="{Binding Loc[ShiftAll]}" Command="{Binding ShiftAllCommand}" />
        <Separator />
        <MenuItem Header="{Binding Loc[Settings]}" Command="{Binding OpenSettingsCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding Loc[MenuHelp]}">
        <MenuItem Header="{Binding Loc[MenuAbout]}" Command="{Binding AboutCommand}" />
      </MenuItem>
    </Menu>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="10,8,10,4">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
        <Button Content="{Binding Loc[OpenProject]}" Command="{Binding OpenProjectCommand}" MinWidth="96" />
        <Button Content="{Binding Loc[OpenVideo]}" Command="{Binding OpenVideoCommand}" MinWidth="88" />
        <Button Content="{Binding Loc[SaveYtt]}" Command="{Binding SaveCommand}" MinWidth="88" />
        <Border Width="1" Background="{DynamicResource AppDividerBrush}" Margin="6,3" />
        <Button Content="{Binding Loc[Undo]}" Command="{Binding UndoCommand}" MinWidth="64" />
        <Button Content="{Binding Loc[Redo]}" Command="{Binding RedoCommand}" MinWidth="64" />
      </StackPanel>
      <Border Grid.Column="1" Background="{DynamicResource AppStatusBackgroundBrush}" CornerRadius="4" Margin="12,0" Padding="10,4">
        <TextBlock Text="{Binding VideoStatus}" VerticalAlignment="Center"
                   Foreground="{DynamicResource AppStrongForegroundBrush}" TextTrimming="CharacterEllipsis" />
      </Border>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Content="{Binding Loc[Settings]}" Command="{Binding OpenSettingsCommand}" MinWidth="90" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="230,6,*,6,300" Margin="10,0,10,0">
      <Border Grid.Column="0" MinWidth="160"
              BorderBrush="{DynamicResource AppPanelBorderBrush}" BorderThickness="1" Padding="8">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="{Binding Loc[StylePresets]}" FontWeight="Bold"
                     TextAlignment="Center" Margin="0,0,0,8" />
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Styles}"
                   SelectedItem="{Binding SelectedStyleOption}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StyleOption">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
            <TextBox Text="{Binding SelectedStyleName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Loc[StyleName]}" />
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
              <Button Content="{Binding Loc[Add]}" Command="{Binding AddStyleCommand}" />
              <Button Content="{Binding Loc[Rename]}" Command="{Binding RenameStyleCommand}" />
              <Button Content="{Binding Loc[Delete]}" Command="{Binding DeleteStyleCommand}" />
            </StackPanel>
            <Button Content="{Binding Loc[SaveCueFormat]}" Command="{Binding SaveCueAsStyleCommand}"
                    HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWestEast"
                    Background="{DynamicResource AppDividerBrush}" />

      <Grid Grid.Column="2" MinWidth="500" RowDefinitions="Auto,3*,6,*,6,2*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
          <Button Content="{Binding Loc[ViewportVideo]}" IsEnabled="True" />
          <Button Content="{Binding Loc[ViewportYouTube]}" IsEnabled="False" ToolTip.Tip="{Binding Loc[ViewportPending]}" />
          <Button Content="{Binding Loc[ViewportTheater]}" IsEnabled="False" ToolTip.Tip="{Binding Loc[ViewportPending]}" />
          <Button Content="{Binding Loc[ViewportFullscreen]}" IsEnabled="False" ToolTip.Tip="{Binding Loc[ViewportPending]}" />
          <Button Content="{Binding Loc[ViewportMobile]}" IsEnabled="False" ToolTip.Tip="{Binding Loc[ViewportPending]}" />
          <TextBlock Text="{Binding Loc[ViewportModeNote]}" VerticalAlignment="Center" Margin="8,0" />
        </StackPanel>

        <Grid Grid.Row="1" MinHeight="190" RowDefinitions="*,Auto,Auto" Margin="0,6,0,0">
        <Border Grid.Row="0" MinHeight="140"
                Background="{DynamicResource AppVideoSurfaceBrush}" BorderBrush="{DynamicResource AppVideoBorderBrush}" BorderThickness="1" ClipToBounds="True">
          <Grid>
            <Image Source="{Binding VideoFrameImage}" Stretch="Uniform" />
            <Image Source="{Binding SubtitleImage}" Stretch="Uniform" IsHitTestVisible="False" />
            <vm:PreviewCanvas>
              <vm:PreviewCanvas.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{Binding Loc[Duplicate]}" Command="{Binding DuplicateCueCommand}" />
                  <MenuItem Header="{Binding Loc[Delete]}" Command="{Binding DeleteCueCommand}" />
                  <Separator />
                  <MenuItem Header="{Binding Loc[ApplySelectedStyle]}" Command="{Binding ApplySelectedStyleCommand}" />
                  <MenuItem Header="{Binding Loc[BringToFront]}" Command="{Binding BringToFrontCommand}" />
                  <MenuItem Header="{Binding Loc[SendToBack]}" Command="{Binding SendToBackCommand}" />
                  <MenuItem Header="{Binding Loc[Alignment]}">
                    <MenuItem Header="{Binding Loc[AlignLeft]}" Command="{Binding AlignLeftCommand}" />
                    <MenuItem Header="{Binding Loc[AlignCenter]}" Command="{Binding AlignCenterCommand}" />
                    <MenuItem Header="{Binding Loc[AlignRight]}" Command="{Binding AlignRightCommand}" />
                    <MenuItem Header="{Binding Loc[AlignTop]}" Command="{Binding AlignTopCommand}" />
                    <MenuItem Header="{Binding Loc[AlignMiddle]}" Command="{Binding AlignMiddleCommand}" />
                    <MenuItem Header="{Binding Loc[AlignBottom]}" Command="{Binding AlignBottomCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding Loc[DistributeHFull]}" Command="{Binding DistributeHorizontalCommand}" />
                    <MenuItem Header="{Binding Loc[DistributeVFull]}" Command="{Binding DistributeVerticalCommand}" />
                  </MenuItem>
                  <MenuItem Header="{Binding Loc[AlignHint]}" IsEnabled="False" />
                  <Separator />
                  <MenuItem Header="{Binding Loc[NoRotation]}" IsEnabled="False" />
                  <MenuItem Header="{Binding Loc[NoFreeScale]}" IsEnabled="False" />
                </ContextMenu>
              </vm:PreviewCanvas.ContextMenu>
            </vm:PreviewCanvas>
            <Canvas IsVisible="{Binding IsInlineEditing}" IsHitTestVisible="{Binding IsInlineEditing}">
              <TextBox x:Name="InlineEditorTextBox"
                       Canvas.Left="{Binding InlineEditorLeft}"
                       Canvas.Top="{Binding InlineEditorTop}"
                       Width="{Binding InlineEditorWidth}"
                       Height="{Binding InlineEditorHeight}"
                       Text="{Binding InlineText, UpdateSourceTrigger=PropertyChanged}"
                       FontFamily="{Binding InlineEditorFontFamily}"
                       FontSize="{Binding InlineEditorFontSize}"
                       Foreground="{Binding InlineEditorForeground}"
                       TextAlignment="{Binding InlineEditorTextAlignment}"
                       Padding="{Binding InlineEditorPadding}"
                       Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                       CaretBrush="{Binding InlineEditorForeground}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinWidth="0" MinHeight="0"
                       KeyDown="OnInlineEditorKeyDown" LostFocus="OnInlineEditorLostFocus">
                <TextBox.Styles>
                  <!-- Fluent 의 TextBox 템플릿은 포커스·마우스오버 상태에서 내부
                       PART_BorderElement 의 배경을 테마 리소스로 덮어쓴다. 그대로 두면
                       자막 위에 흰 상자가 얹혀 제자리 편집이 되지 않는다. -->
                  <Style Selector="TextBox#InlineEditorTextBox /template/ Border#PART_BorderElement">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                  </Style>
                  <Style Selector="TextBox#InlineEditorTextBox:pointerover /template/ Border#PART_BorderElement">
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                  <Style Selector="TextBox#InlineEditorTextBox:focus /template/ Border#PART_BorderElement">
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                </TextBox.Styles>
              </TextBox>
            </Canvas>
          </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,100" ColumnSpacing="6"
              Margin="0,6,0,0" HorizontalAlignment="Stretch" IsEnabled="{Binding HasVideo}">
          <Button Grid.Column="0" Content="◀" Command="{Binding StepBackCommand}"
                  Width="36" MinHeight="32" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}"
                  ToolTip.Tip="{Binding PlayPauseActionText}"
                  AutomationProperties.Name="{Binding PlayPauseActionText}"
                  Width="36" MinHeight="32" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="▶" Command="{Binding StepForwardCommand}"
                  Width="36" MinHeight="32" VerticalAlignment="Center" />
          <Slider Grid.Column="3" Minimum="0" Maximum="{Binding MaximumMilliseconds}"
                  Value="{Binding PositionMilliseconds}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="4" Text="{Binding PositionDisplay}" Width="92" TextAlignment="Right"
                     VerticalAlignment="Center" />
          <ComboBox Grid.Column="5" ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding PlaybackSpeed}"
                    Width="72" MinHeight="32" VerticalAlignment="Center" />
          <ToggleButton Grid.Column="6" Content="{Binding MuteLabel}" IsChecked="{Binding IsMuted}"
                        ToolTip.Tip="{Binding Loc[Mute]}" MinHeight="32" VerticalAlignment="Center" />
          <Slider Grid.Column="7" Minimum="0" Maximum="100" Value="{Binding Volume}" Width="100"
                  ToolTip.Tip="{Binding Loc[Volume]}" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Loc[TimelineHint]}" TextAlignment="Center"
                   Foreground="{DynamicResource AppSubtleForegroundBrush}" />
        </Grid>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNorthSouth"
                      Background="{DynamicResource AppDividerBrush}" />
        <vm:TimelineControl Grid.Row="3" MinHeight="72" />

        <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNorthSouth"
                      Background="{DynamicResource AppDividerBrush}" />

        <Border Grid.Row="5" MinHeight="100"
                BorderBrush="{DynamicResource AppPanelBorderBrush}" BorderThickness="1">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="40,104,104,88,64,120,*" ColumnSpacing="8"
                  Background="{DynamicResource AppTableHeaderBrush}" Margin="0,0,14,0" Height="30">
              <TextBlock Grid.Column="0" Text="#" VerticalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AppTableHeaderForegroundBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding Loc[StartMs]}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,4,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTableHeaderForegroundBrush}" />
              <TextBlock Grid.Column="2" Text="{Binding Loc[EndMs]}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,4,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTableHeaderForegroundBrush}" />
              <TextBlock Grid.Column="3" Text="{Binding Loc[Duration]}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTableHeaderForegroundBrush}" />
              <TextBlock Grid.Column="4" Text="{Binding Loc[Track]}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,4,0" FontWeight="SemiBold" Foreground="{DynamicResource AppTableHeaderForegroundBrush}" />
              <TextBlock Grid.Column="5" Text="{Binding Loc[Style]}" VerticalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AppTableHeaderForegroundBrush}" />
              <TextBlock Grid.Column="6" Text="{Binding Loc[TextSection]}" VerticalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AppTableHeaderForegroundBrush}" />
            </Grid>
            <ListBox x:Name="CueList" Grid.Row="1" Classes="cueTable" ItemsSource="{Binding CueRows}"
                     SelectedItem="{Binding SelectedCueRow}">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
                <Style Selector="TextBox.cueTableEditor">
                  <Setter Property="MinWidth" Value="0" />
                  <Setter Property="MinHeight" Value="0" />
                  <Setter Property="Height" Value="26" />
                  <Setter Property="Padding" Value="4,2" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="TextWrapping" Value="NoWrap" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CueRowViewModel">
                  <Grid ColumnDefinitions="40,104,104,88,64,120,*" ColumnSpacing="8" Margin="0" Height="30">
                    <TextBlock Grid.Column="0" Text="{Binding Number}" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource AppMutedForegroundBrush}" />
                    <TextBox Grid.Column="1" Classes="cueTableEditor" Text="{Binding StartMilliseconds}" HorizontalContentAlignment="Right" />
                    <TextBox Grid.Column="2" Classes="cueTableEditor" Text="{Binding EndMilliseconds}" HorizontalContentAlignment="Right" />
                    <TextBlock Grid.Column="3" Text="{Binding DurationMilliseconds}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" Foreground="{DynamicResource AppStrongForegroundBrush}" />
                    <TextBox Grid.Column="4" Classes="cueTableEditor" Text="{Binding Track}" HorizontalContentAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="{Binding Style}" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AppStrongForegroundBrush}" />
                    <TextBox Grid.Column="6" Classes="cueTableEditor" Text="{Binding Text}" MinWidth="160" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWestEast"
                    Background="{DynamicResource AppDividerBrush}" />

      <Border Grid.Column="4" MinWidth="260"
              BorderBrush="{DynamicResource AppPanelBorderBrush}" BorderThickness="1" Padding="8">
        <ScrollViewer>
          <StackPanel Spacing="8" Width="240" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Loc[Properties]}" FontWeight="Bold" TextAlignment="Center" />
            <TextBlock Text="{Binding SelectionSummary}" Foreground="{DynamicResource AppSubtleForegroundBrush}" TextWrapping="Wrap" TextAlignment="Center" />

            <Expander Header="{Binding Loc[PositionAndAlign]}" IsExpanded="True">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="{Binding Loc[AnchorPoint]}" />
                <vm:AnchorPicker HorizontalAlignment="Left" />
                  <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="5">
                    <TextBlock Grid.Column="0" Text="X" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding SelectedPositionXText}" />
                  <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" />
                  <TextBox Grid.Column="3" Text="{Binding SelectedPositionYText}" />
                  </Grid>
                <TextBlock Text="{Binding SelectedAnchorDisplay}" Foreground="{DynamicResource AppSubtleForegroundBrush}" />
                <TextBlock Text="{Binding Loc[BoxJustify]}" />
                <vm:JustificationPicker />
                <TextBlock Text="{Binding SelectedJustificationDisplay}" Foreground="{DynamicResource AppSubtleForegroundBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <Button Content="{Binding Loc[Left]}" Command="{Binding AlignLeftCommand}" />
                  <Button Content="{Binding Loc[Center]}" Command="{Binding AlignCenterCommand}" />
                  <Button Content="{Binding Loc[Right]}" Command="{Binding AlignRightCommand}" />
                  <Button Content="{Binding Loc[Top]}" Command="{Binding AlignTopCommand}" />
                  <Button Content="{Binding Loc[Center]}" Command="{Binding AlignMiddleCommand}" />
                  <Button Content="{Binding Loc[Bottom]}" Command="{Binding AlignBottomCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <Button Content="{Binding Loc[DistributeH]}" Command="{Binding DistributeHorizontalCommand}" />
                  <Button Content="{Binding Loc[DistributeV]}" Command="{Binding DistributeVerticalCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Loc[MultilineOnly]}" FontSize="11" Foreground="{DynamicResource AppSubtleForegroundBrush}" />
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[TextSection]}" IsExpanded="True">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="{Binding Loc[TextEditHint]}" />
                <TextBox Text="{Binding SelectedText}" AcceptsReturn="True" MinHeight="54" />
                <TextBlock Text="{Binding Loc[Style]}" />
                <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedCueStyleOption}" />
                <TextBlock Text="{Binding Loc[StyleListHint]}" FontSize="11" Foreground="{DynamicResource AppSubtleForegroundBrush}" />
                <TextBlock Text="{Binding Loc[TextDirection]}" />
                <ComboBox ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding SelectedDirection}" />
                <TextBlock Text="{Binding Loc[Font]}" />
                <ComboBox ItemsSource="{Binding FontOptions}" SelectedItem="{Binding SelectedFont}" />
                <TextBlock Text="{Binding Loc[SizePercent]}" />
                <Slider Minimum="75" Maximum="200" Value="{Binding SelectedSizePercentValue}" />
                <NumericUpDown Minimum="75" Maximum="1000" Value="{Binding SelectedSizePercentValue}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox Content="B" IsThreeState="True" IsChecked="{Binding SelectedBold}" />
                  <CheckBox Content="I" IsThreeState="True" IsChecked="{Binding SelectedItalic}" />
                  <CheckBox Content="U" IsThreeState="True" IsChecked="{Binding SelectedUnderline}" />
                </StackPanel>
                <TextBlock Text="{Binding Loc[CharOffset]}" />
                <ComboBox ItemsSource="{Binding ScriptOffsetOptions}" SelectedItem="{Binding SelectedScriptOffset}" />
                <CheckBox Content="{Binding Loc[Pack]}" IsThreeState="True" IsChecked="{Binding SelectedPack}" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Loc[Foreground]}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ForegroundHex}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Loc[Background]}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BackgroundHex}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Loc[ForegroundOpacity]}" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ForegroundOpacity}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Loc[BackgroundOpacity]}" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BackgroundOpacity}" />
                </Grid>
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[EdgeShadow]}" IsExpanded="True">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <ComboBox ItemsSource="{Binding EdgeOptions}" SelectedItem="{Binding SelectedEdge}" />
                <TextBox Text="{Binding EdgeColorHex}" PlaceholderText="#RRGGBBAA" />
                <NumericUpDown Minimum="0" Maximum="255" Value="{Binding EdgeOpacity}" />
                <TextBlock Text="{Binding Loc[CompatPcNote]}" FontSize="11" Foreground="{DynamicResource AppSubtleForegroundBrush}"
                           ToolTip.Tip="{Binding Loc[CompatSpecNote]}" />
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[Effects]}" IsExpanded="True">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <CheckBox Content="{Binding Loc[EffectMove]}" IsChecked="{Binding MoveEffectEnabled}" />
                <CheckBox Content="{Binding Loc[EffectFade]}" IsChecked="{Binding FadeEffectEnabled}" />
                <CheckBox Content="{Binding Loc[EffectShake]}" IsChecked="{Binding ShakeEffectEnabled}" />
                <CheckBox Content="{Binding Loc[EffectChroma]}" IsChecked="{Binding ChromaEffectEnabled}" />
                <CheckBox Content="{Binding Loc[EffectAnimate]}" IsChecked="{Binding AnimateEffectEnabled}" />
                <TextBlock Text="{Binding Loc[EffectDefaultNote]}"
                           FontSize="11" Foreground="{DynamicResource AppSubtleForegroundBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[SearchReplace]}" IsExpanded="False">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="{Binding Loc[FindWhat]}" />
                <TextBox Text="{Binding SearchPattern}" />
                <TextBlock Text="{Binding Loc[ReplaceWith]}" />
                <TextBox Text="{Binding ReplacementText}" />
                <CheckBox Content="{Binding Loc[UseRegex]}" IsChecked="{Binding UseRegex}" />
                <CheckBox Content="{Binding Loc[MatchCase]}" IsChecked="{Binding MatchCase}" />
                <Button Content="{Binding Loc[ReplaceAll]}" Command="{Binding ReplaceAllCommand}"
                        HorizontalAlignment="Stretch" />
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[TimeShift]}" IsExpanded="False">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="{Binding Loc[ShiftMs]}" />
                <TextBox Text="{Binding ShiftMilliseconds}" HorizontalContentAlignment="Right" />
                <Button Content="{Binding Loc[ShiftSelected]}" Command="{Binding ShiftSelectedCommand}"
                        HorizontalAlignment="Stretch" />
                <Button Content="{Binding Loc[ShiftAll]}" Command="{Binding ShiftAllCommand}"
                        HorizontalAlignment="Stretch" />
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[Ruby]}" IsExpanded="False">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Loc[RubyRole]}" VerticalAlignment="Center" />
                  <Border Background="{DynamicResource AppBadgeBackgroundBrush}" CornerRadius="3" Padding="5,1">
                    <TextBlock Text="{Binding Loc[PcOnlyBadge]}" FontSize="10" Foreground="{DynamicResource AppBadgeForegroundBrush}"
                               ToolTip.Tip="{Binding Loc[CompatSpecNote]}" />
                  </Border>
                </StackPanel>
                <ComboBox ItemsSource="{Binding RubyRoles}" SelectedItem="{Binding SelectedRubyRole}"
                          HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding Loc[RubyText]}" />
                <TextBox Text="{Binding SelectedRubyText}" />
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[ValidationIssues]}" IsExpanded="True">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <Button Content="{Binding Loc[RunCheck]}" Command="{Binding ValidateCommand}" />
                <TextBlock Text="{Binding Loc[W101Note]}"
                           FontSize="11" Foreground="{DynamicResource AppWarningForegroundBrush}" TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding ValidationIssues}" SelectedItem="{Binding SelectedValidationIssue}"
                         MaxHeight="220">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="2">
                        <TextBlock Text="{Binding Code}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Button Content="{Binding Loc[GoToCue]}" Command="{Binding GoToValidationIssueCommand}" />
                  <Button Content="{Binding Loc[AutoFix]}" Command="{Binding ApplyValidationFixCommand}" />
                </StackPanel>
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[Karaoke]}" IsExpanded="True">
              <StackPanel Spacing="7" Margin="0,6,0,0">
                <TextBlock Text="{Binding Loc[KaraokeTapHint]}"
                           FontSize="11" Foreground="{DynamicResource AppWarningForegroundBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="{Binding Loc[AutoSplit]}" Command="{Binding AutoSplitKaraokeCommand}" />
                  <ComboBox Width="105" ItemsSource="{Binding KaraokeTypeOptions}"
                            SelectedItem="{Binding SelectedKaraokeTypeOption}" />
                </StackPanel>
                <vm:KaraokeTimelineControl />
                <ItemsControl ItemsSource="{Binding KaraokeSections}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KaraokeSectionViewModel">
                      <Grid ColumnDefinitions="*,70,Auto,Auto" ColumnSpacing="4" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding Text}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding OffsetMillisecondsText}"
                                 PlaceholderText="ms" HorizontalContentAlignment="Right" />
                        <Button Grid.Column="2" Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Loc[Split]}" Command="{Binding SplitCommand}" />
                        <Button Grid.Column="3" Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Loc[Merge]}" Command="{Binding MergeNextCommand}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Loc[WaveformUnavailable]}"
                           FontSize="11" Foreground="{DynamicResource AppSubtleForegroundBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid Grid.Row="3" MinHeight="40" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="10,4,10,4">
      <TextBlock Grid.Column="0" Text="{Binding Status}" TextWrapping="Wrap" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button Content="{Binding Loc[AddCueAtTime]}" Command="{Binding AddCueCommand}" />
        <Button Content="{Binding Loc[Duplicate]}" Command="{Binding DuplicateCueCommand}" />
        <Button Content="{Binding Loc[Delete]}" Command="{Binding DeleteCueCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
