<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:YttStudio.App"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        x:Class="YttStudio.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="700"
        Title="YttStudio — M2 영상 파이프라인 + 편집 캔버스">
  <Grid RowDefinitions="Auto,*,Auto" Margin="10" RowSpacing="8">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
        <Button Content="{Binding Loc[OpenProject]}" Command="{Binding OpenProjectCommand}" />
        <Button Content="{Binding Loc[SaveProject]}" Command="{Binding SaveProjectCommand}" />
        <Border Width="1" Background="#444" Margin="4,2" />
        <Button Content="{Binding Loc[OpenSubtitle]}" Command="{Binding OpenSubtitleCommand}" />
        <Button Content="{Binding Loc[OpenVideo]}" Command="{Binding OpenVideoCommand}" />
        <Button Content="{Binding Loc[SaveYtt]}" Command="{Binding SaveCommand}" />
        <Border Width="1" Background="#444" Margin="4,2" />
        <Button Content="{Binding Loc[Undo]}" Command="{Binding UndoCommand}" />
        <Button Content="{Binding Loc[Redo]}" Command="{Binding RedoCommand}" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding VideoStatus}" VerticalAlignment="Center" Margin="10,0" />
      <CheckBox Grid.Column="2" Content="{Binding Loc[CheckerboardBg]}" IsChecked="{Binding UseCheckerboard}" />
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="{Binding Loc[LanguageLabel]}" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" MinWidth="110" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="210,*,280" ColumnSpacing="8">
      <Border Grid.Column="0" BorderBrush="#444" BorderThickness="1" Padding="8">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="{Binding Loc[StylePresets]}" FontWeight="Bold" Margin="0,0,0,8" />
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Styles}"
                   SelectedItem="{Binding SelectedStyleOption}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StyleOption">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Spacing="5" Margin="0,8,0,0">
            <TextBox Text="{Binding SelectedStyleName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Loc[StyleName]}" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="{Binding Loc[Add]}" Command="{Binding AddStyleCommand}" />
              <Button Content="{Binding Loc[Rename]}" Command="{Binding RenameStyleCommand}" />
              <Button Content="{Binding Loc[Delete]}" Command="{Binding DeleteStyleCommand}" />
            </StackPanel>
            <Button Content="{Binding Loc[SaveCueFormat]}" Command="{Binding SaveCueAsStyleCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,3*,Auto,Auto,*,2*" RowSpacing="6">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
          <Button Content="{Binding Loc[ViewportVideo]}" IsEnabled="True" />
          <Button Content="{Binding Loc[ViewportYouTube]}" IsEnabled="False" ToolTip.Tip="{Binding Loc[ViewportPending]}" />
          <Button Content="{Binding Loc[ViewportTheater]}" IsEnabled="False" ToolTip.Tip="{Binding Loc[ViewportPending]}" />
          <Button Content="{Binding Loc[ViewportFullscreen]}" IsEnabled="False" ToolTip.Tip="{Binding Loc[ViewportPending]}" />
          <Button Content="{Binding Loc[ViewportMobile]}" IsEnabled="False" ToolTip.Tip="{Binding Loc[ViewportPending]}" />
          <TextBlock Text="{Binding Loc[ViewportModeNote]}" VerticalAlignment="Center" Margin="8,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#111" BorderBrush="#555" BorderThickness="1" ClipToBounds="True">
          <Grid>
            <Image Source="{Binding VideoFrameImage}" Stretch="Uniform" />
            <Image Source="{Binding SubtitleImage}" Stretch="Uniform" IsHitTestVisible="False" />
            <vm:PreviewCanvas>
              <vm:PreviewCanvas.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{Binding Loc[Duplicate]}" Command="{Binding DuplicateCueCommand}" />
                  <MenuItem Header="{Binding Loc[Delete]}" Command="{Binding DeleteCueCommand}" />
                  <Separator />
                  <MenuItem Header="{Binding Loc[ApplySelectedStyle]}" Command="{Binding ApplySelectedStyleCommand}" />
                  <MenuItem Header="{Binding Loc[BringToFront]}" Command="{Binding BringToFrontCommand}" />
                  <MenuItem Header="{Binding Loc[SendToBack]}" Command="{Binding SendToBackCommand}" />
                  <MenuItem Header="{Binding Loc[Alignment]}">
                    <MenuItem Header="{Binding Loc[AlignLeft]}" Command="{Binding AlignLeftCommand}" />
                    <MenuItem Header="{Binding Loc[AlignCenter]}" Command="{Binding AlignCenterCommand}" />
                    <MenuItem Header="{Binding Loc[AlignRight]}" Command="{Binding AlignRightCommand}" />
                    <MenuItem Header="{Binding Loc[AlignTop]}" Command="{Binding AlignTopCommand}" />
                    <MenuItem Header="{Binding Loc[AlignMiddle]}" Command="{Binding AlignMiddleCommand}" />
                    <MenuItem Header="{Binding Loc[AlignBottom]}" Command="{Binding AlignBottomCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding Loc[DistributeHFull]}" Command="{Binding DistributeHorizontalCommand}" />
                    <MenuItem Header="{Binding Loc[DistributeVFull]}" Command="{Binding DistributeVerticalCommand}" />
                  </MenuItem>
                  <MenuItem Header="{Binding Loc[AlignHint]}" IsEnabled="False" />
                  <Separator />
                  <MenuItem Header="{Binding Loc[NoRotation]}" IsEnabled="False" />
                  <MenuItem Header="{Binding Loc[NoFreeScale]}" IsEnabled="False" />
                </ContextMenu>
              </vm:PreviewCanvas.ContextMenu>
            </vm:PreviewCanvas>
            <Canvas IsVisible="{Binding IsInlineEditing}" IsHitTestVisible="{Binding IsInlineEditing}">
              <StackPanel Canvas.Left="{Binding InlineEditorLeft}"
                          Canvas.Top="{Binding InlineEditorTop}"
                          Width="{Binding InlineEditorWidth}"
                          Orientation="Horizontal"
                          Spacing="4">
                <TextBox Text="{Binding InlineText}" AcceptsReturn="True" MinWidth="120" />
                <Button Content="{Binding Loc[Apply]}" Command="{Binding CommitInlineEditCommand}" />
              </StackPanel>
            </Canvas>
          </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
          <Button Grid.Column="0" Content="◀" Command="{Binding StepBackCommand}" />
          <Button Grid.Column="1" Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}" />
          <Button Grid.Column="2" Content="▶" Command="{Binding StepForwardCommand}" />
          <Slider Grid.Column="3" Minimum="0" Maximum="{Binding MaximumMilliseconds}"
                  Value="{Binding PositionMilliseconds}" />
          <TextBlock Grid.Column="4" Text="{Binding PositionDisplay}" Width="92" TextAlignment="Right"
                     VerticalAlignment="Center" />
          <ComboBox Grid.Column="5" ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding PlaybackSpeed}"
                    Width="72" />
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding Loc[TimelineHint]}"
                   Foreground="#AAA" />
        <vm:TimelineControl Grid.Row="4" />

        <Border Grid.Row="5" BorderBrush="#444" BorderThickness="1">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="34,92,92,72,54,80,*" Background="#292929">
              <TextBlock Grid.Column="0" Text="#" />
              <TextBlock Grid.Column="1" Text="{Binding Loc[StartMs]}" />
              <TextBlock Grid.Column="2" Text="{Binding Loc[EndMs]}" />
              <TextBlock Grid.Column="3" Text="{Binding Loc[Duration]}" />
              <TextBlock Grid.Column="4" Text="{Binding Loc[Track]}" />
              <TextBlock Grid.Column="5" Text="{Binding Loc[Style]}" />
              <TextBlock Grid.Column="6" Text="{Binding Loc[TextSection]}" />
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding CueRows}" SelectedItem="{Binding SelectedCueRow}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CueRowViewModel">
                  <Grid ColumnDefinitions="34,92,92,72,54,80,*">
                    <TextBlock Grid.Column="0" Text="{Binding Number}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding StartMilliseconds}" />
                    <TextBox Grid.Column="2" Text="{Binding EndMilliseconds}" />
                    <TextBlock Grid.Column="3" Text="{Binding DurationMilliseconds}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="4" Text="{Binding Track}" />
                    <TextBlock Grid.Column="5" Text="{Binding Style}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="6" Text="{Binding Text}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="2" BorderBrush="#444" BorderThickness="1" Padding="8">
        <ScrollViewer>
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Loc[Properties]}" FontWeight="Bold" />
            <TextBlock Text="{Binding SelectionSummary}" Foreground="#AAA" TextWrapping="Wrap" />

            <Expander Header="{Binding Loc[PositionAndAlign]}" IsExpanded="True">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="{Binding Loc[AnchorPoint]}" />
                <vm:AnchorPicker HorizontalAlignment="Left" />
                  <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="5">
                    <TextBlock Grid.Column="0" Text="X" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding SelectedPositionXText}" />
                  <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" />
                  <TextBox Grid.Column="3" Text="{Binding SelectedPositionYText}" />
                  </Grid>
                <TextBlock Text="{Binding SelectedAnchorDisplay}" Foreground="#AAA" />
                <TextBlock Text="{Binding Loc[BoxJustify]}" />
                <vm:JustificationPicker />
                <TextBlock Text="{Binding SelectedJustificationDisplay}" Foreground="#AAA" />
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <Button Content="{Binding Loc[Left]}" Command="{Binding AlignLeftCommand}" />
                  <Button Content="{Binding Loc[Center]}" Command="{Binding AlignCenterCommand}" />
                  <Button Content="{Binding Loc[Right]}" Command="{Binding AlignRightCommand}" />
                  <Button Content="{Binding Loc[Top]}" Command="{Binding AlignTopCommand}" />
                  <Button Content="{Binding Loc[Center]}" Command="{Binding AlignMiddleCommand}" />
                  <Button Content="{Binding Loc[Bottom]}" Command="{Binding AlignBottomCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <Button Content="{Binding Loc[DistributeH]}" Command="{Binding DistributeHorizontalCommand}" />
                  <Button Content="{Binding Loc[DistributeV]}" Command="{Binding DistributeVerticalCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Loc[MultilineOnly]}" FontSize="11" Foreground="#AAA" />
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[TextSection]}" IsExpanded="True">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="{Binding Loc[TextEditHint]}" />
                <TextBox Text="{Binding SelectedText}" AcceptsReturn="True" MinHeight="54" />
                <TextBlock Text="{Binding Loc[Style]}" />
                <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedCueStyleOption}" />
                <TextBlock Text="{Binding Loc[StyleListHint]}" FontSize="11" Foreground="#AAA" />
                <TextBlock Text="{Binding Loc[TextDirection]}" />
                <ComboBox ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding SelectedDirection}" />
                <TextBlock Text="{Binding Loc[Font]}" />
                <ComboBox ItemsSource="{Binding FontOptions}" SelectedItem="{Binding SelectedFont}" />
                <TextBlock Text="{Binding Loc[SizePercent]}" />
                <Slider Minimum="75" Maximum="200" Value="{Binding SelectedSizePercentValue}" />
                <NumericUpDown Minimum="75" Maximum="1000" Value="{Binding SelectedSizePercentValue}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox Content="B" IsThreeState="True" IsChecked="{Binding SelectedBold}" />
                  <CheckBox Content="I" IsThreeState="True" IsChecked="{Binding SelectedItalic}" />
                  <CheckBox Content="U" IsThreeState="True" IsChecked="{Binding SelectedUnderline}" />
                </StackPanel>
                <TextBlock Text="{Binding Loc[CharOffset]}" />
                <ComboBox ItemsSource="{Binding ScriptOffsetOptions}" SelectedItem="{Binding SelectedScriptOffset}" />
                <CheckBox Content="{Binding Loc[Pack]}" IsThreeState="True" IsChecked="{Binding SelectedPack}" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Loc[Foreground]}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ForegroundHex}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Loc[Background]}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BackgroundHex}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Loc[ForegroundOpacity]}" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding ForegroundOpacity}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Loc[BackgroundOpacity]}" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BackgroundOpacity}" />
                </Grid>
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[EdgeShadow]}" IsExpanded="True">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <ComboBox ItemsSource="{Binding EdgeOptions}" SelectedItem="{Binding SelectedEdge}" />
                <TextBox Text="{Binding EdgeColorHex}" PlaceholderText="#RRGGBBAA" />
                <NumericUpDown Minimum="0" Maximum="255" Value="{Binding EdgeOpacity}" />
                <TextBlock Text="{Binding Loc[CompatPcNote]}" FontSize="11" Foreground="#AAA"
                           ToolTip.Tip="{Binding Loc[CompatSpecNote]}" />
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[Effects]}" IsExpanded="True">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <CheckBox Content="{Binding Loc[EffectMove]}" IsChecked="{Binding MoveEffectEnabled}" />
                <CheckBox Content="{Binding Loc[EffectFade]}" IsChecked="{Binding FadeEffectEnabled}" />
                <CheckBox Content="{Binding Loc[EffectShake]}" IsChecked="{Binding ShakeEffectEnabled}" />
                <CheckBox Content="{Binding Loc[EffectChroma]}" IsChecked="{Binding ChromaEffectEnabled}" />
                <CheckBox Content="{Binding Loc[EffectAnimate]}" IsChecked="{Binding AnimateEffectEnabled}" />
                <TextBlock Text="{Binding Loc[EffectDefaultNote]}"
                           FontSize="11" Foreground="#AAA" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[SearchReplace]}" IsExpanded="False">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="{Binding Loc[FindWhat]}" />
                <TextBox Text="{Binding SearchPattern}" />
                <TextBlock Text="{Binding Loc[ReplaceWith]}" />
                <TextBox Text="{Binding ReplacementText}" />
                <CheckBox Content="{Binding Loc[UseRegex]}" IsChecked="{Binding UseRegex}" />
                <CheckBox Content="{Binding Loc[MatchCase]}" IsChecked="{Binding MatchCase}" />
                <Button Content="{Binding Loc[ReplaceAll]}" Command="{Binding ReplaceAllCommand}"
                        HorizontalAlignment="Stretch" />
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[TimeShift]}" IsExpanded="False">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="{Binding Loc[ShiftMs]}" />
                <TextBox Text="{Binding ShiftMilliseconds}" HorizontalContentAlignment="Right" />
                <Button Content="{Binding Loc[ShiftSelected]}" Command="{Binding ShiftSelectedCommand}"
                        HorizontalAlignment="Stretch" />
                <Button Content="{Binding Loc[ShiftAll]}" Command="{Binding ShiftAllCommand}"
                        HorizontalAlignment="Stretch" />
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[Ruby]}" IsExpanded="False">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Loc[RubyRole]}" VerticalAlignment="Center" />
                  <Border Background="#3A3A3A" CornerRadius="3" Padding="5,1">
                    <TextBlock Text="{Binding Loc[PcOnlyBadge]}" FontSize="10" Foreground="#DDD"
                               ToolTip.Tip="{Binding Loc[CompatSpecNote]}" />
                  </Border>
                </StackPanel>
                <ComboBox ItemsSource="{Binding RubyRoles}" SelectedItem="{Binding SelectedRubyRole}"
                          HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding Loc[RubyText]}" />
                <TextBox Text="{Binding SelectedRubyText}" />
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[Settings]}" IsExpanded="False">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="{Binding Loc[LanguageLabel]}" />
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                          HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding Loc[SnapThreshold]}" />
                <TextBox Text="{Binding SnapThreshold}" HorizontalContentAlignment="Right" />
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[ValidationIssues]}" IsExpanded="True">
              <StackPanel Spacing="6" Margin="0,6,0,0">
                <Button Content="{Binding Loc[RunCheck]}" Command="{Binding ValidateCommand}" />
                <TextBlock Text="{Binding Loc[W101Note]}"
                           FontSize="11" Foreground="#E5B567" TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding ValidationIssues}" SelectedItem="{Binding SelectedValidationIssue}"
                         MaxHeight="220">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="2">
                        <TextBlock Text="{Binding Code}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Button Content="{Binding Loc[GoToCue]}" Command="{Binding GoToValidationIssueCommand}" />
                  <Button Content="{Binding Loc[AutoFix]}" Command="{Binding ApplyValidationFixCommand}" />
                </StackPanel>
              </StackPanel>
            </Expander>

            <Expander Header="{Binding Loc[Karaoke]}" IsExpanded="True">
              <StackPanel Spacing="7" Margin="0,6,0,0">
                <TextBlock Text="{Binding Loc[KaraokeTapHint]}"
                           FontSize="11" Foreground="#E5B567" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="{Binding Loc[AutoSplit]}" Command="{Binding AutoSplitKaraokeCommand}" />
                  <ComboBox Width="105" ItemsSource="{Binding KaraokeTypeOptions}"
                            SelectedItem="{Binding SelectedKaraokeTypeOption}" />
                </StackPanel>
                <vm:KaraokeTimelineControl />
                <ItemsControl ItemsSource="{Binding KaraokeSections}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KaraokeSectionViewModel">
                      <Grid ColumnDefinitions="*,70,Auto,Auto" ColumnSpacing="4" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding Text}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding OffsetMillisecondsText}"
                                 PlaceholderText="ms" HorizontalContentAlignment="Right" />
                        <Button Grid.Column="2" Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Loc[Split]}" Command="{Binding SplitCommand}" />
                        <Button Grid.Column="3" Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Loc[Merge]}" Command="{Binding MergeNextCommand}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Loc[WaveformUnavailable]}"
                           FontSize="11" Foreground="#AAA" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBlock Grid.Column="0" Text="{Binding Status}" TextWrapping="Wrap" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button Content="{Binding Loc[AddCueAtTime]}" Command="{Binding AddCueCommand}" />
        <Button Content="{Binding Loc[Duplicate]}" Command="{Binding DuplicateCueCommand}" />
        <Button Content="{Binding Loc[Delete]}" Command="{Binding DeleteCueCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
