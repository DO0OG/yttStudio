<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:YttStudio.App"
        mc:Ignorable="d"
        d:DesignWidth="1120"
        d:DesignHeight="760"
        x:Class="YttStudio.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1120"
        Height="760"
        MinWidth="720"
        MinHeight="520"
        Title="YttStudio — M1 Renderer">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16" RowSpacing="12">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <Button Content="열기 (.ytt / .ass)" Command="{Binding OpenCommand}" />
      <Button Content="YTT 저장" Command="{Binding SaveCommand}" IsEnabled="{Binding HasProject}" />
      <CheckBox Content="체커보드 배경" IsChecked="{Binding UseCheckerboard}" VerticalAlignment="Center" />
    </StackPanel>

    <Border Grid.Row="1" Background="#202020" BorderBrush="#555" BorderThickness="1">
      <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
      <TextBlock Grid.Column="0" Text="시간" VerticalAlignment="Center" />
      <Slider Grid.Column="1"
              Minimum="0"
              Maximum="{Binding MaximumMilliseconds}"
              Value="{Binding PositionMilliseconds}" />
      <TextBlock Grid.Column="2" Text="{Binding PositionDisplay}" Width="92" TextAlignment="Right" />
    </Grid>

    <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" />
  </Grid>
</Window>
